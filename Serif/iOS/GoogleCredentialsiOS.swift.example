import Foundation

/// Fill in your Google OAuth 2.0 iOS credentials from the Google Cloud Console.
/// Copy this file as GoogleCredentialsiOS.swift and fill in your values.
/// iOS clients use PKCE (no client secret). Redirect via reversed client ID URL scheme.
enum GoogleCredentialsiOS {
    static let clientID    = "YOUR_IOS_CLIENT_ID.apps.googleusercontent.com"
    static let redirectURI = "com.googleusercontent.apps.YOUR_IOS_CLIENT_ID:/oauth2redirect"

    static let scopes = [
        "https://mail.google.com/",
        "https://www.googleapis.com/auth/gmail.settings.basic",
        "https://www.googleapis.com/auth/userinfo.email",
        "https://www.googleapis.com/auth/userinfo.profile",
        "https://www.googleapis.com/auth/contacts.readonly",
        "https://www.googleapis.com/auth/contacts.other.readonly"
    ]
}
